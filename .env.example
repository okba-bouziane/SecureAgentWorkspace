# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# --- LLM: any OpenAI-compatible endpoint ---------------------------------
# Groq (default). Pick any chat model with tool calling that your account can use.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional: reasoning effort for models that support it (gpt-oss: low | medium | high)
LLM_REASONING_EFFORT=low
# Optional second guardrail layer: a prompt-injection classifier served on the same endpoint
GUARD_MODEL=
# Ollama instead (no key needed):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen3:8b

# --- Optional: send traces to Langfuse as well as Postgres ------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional tuning ---------------------------------------------------------
CHAT_RATE_LIMIT=20
# SECUREMCP_PATH=../SecureMCP
