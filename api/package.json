{
  "name": "@saw/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "evals": "vitest run --config vitest.evals.config.ts",
    "evals:live": "tsx evals/live-routing.ts",
    "prefetch-model": "tsx scripts/prefetch-model.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@langchain/openai": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pgvector": "0.3.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "esbuild@0.28.2": true
  }
}
